# FloodGuard India — local configuration
# Copy this file to .env and edit as needed. The app runs without any values set.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
APP_BASE_URL=http://127.0.0.1:8000
REFRESH_MINUTES=30
AUTO_TRAIN=true

# ---------------------------------------------------------------------------
# Training data
# ---------------------------------------------------------------------------
TRAIN_START_DATE=2019-01-01
HISTORY_LAG_DAYS=7
HISTORY_CACHE_HOURS=24

# ---------------------------------------------------------------------------
# Model / alert policy
# ---------------------------------------------------------------------------
ALERT_MIN_LEVEL=2
ALERT_HORIZON_DAYS=3
ALERT_COOLDOWN_HOURS=12
HYBRID_MODEL_WEIGHT=0.4

# ---------------------------------------------------------------------------
# Email delivery (leave SMTP_HOST blank to use simulation mode)
# Every simulated message is written to data/outbox.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=FloodGuard India
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional Open-Meteo commercial API key. The free endpoints work without it.
OPENMETEO_API_KEY=
